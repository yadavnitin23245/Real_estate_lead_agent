# Backend settings. Copy to backend/.env and fill in.  Never commit .env.
#
# Point DB_* (or DATABASE_URL) at ANY Postgres server that has pgvector, then run
#   python manage.py setup
# to create the database (if missing), create all tables and seed demo data.

# ---- Database ----
DB_HOST=localhost
DB_PORT=5440
POSTGRES_USER=homematch
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=homematch
# Optional: full URL instead of the parts above (takes precedence)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---- Admin (created on first setup; password is hashed before saving) ----
ADMIN_EMAIL=admin@greenkey.example
ADMIN_PASSWORD=change-me-admin-password

# ---- Demo accounts (buyer / seller / 4 sales agents share this password) ----
DEMO_PASSWORD=change-me-demo-password

# Run migrations + idempotent seed every time the backend container starts
SEED_ON_STARTUP=true

# ---- Embeddings ----
# local = sentence-transformers on CPU (free) | litellm = any LiteLLM model | hash = tests only
EMBED_BACKEND=local
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384

# ---- LLM (used from step 5) ----
LLM_MODEL=groq/openai/gpt-oss-120b
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Auth (used from step 2) ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- File storage ----
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# ---- Langfuse tracing (optional; enabled when both keys are set) ----
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

CORS_ORIGINS=http://localhost:5173
